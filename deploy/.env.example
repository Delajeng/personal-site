# Copy to .env on the Docker host and fill in. Never commit the real .env.

# Your image from GitHub Container Registry - all lowercase.
SITE_IMAGE=ghcr.io/your-github-user/your-repo:latest

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install connector (Docker).
# Copy only the long token after "--token".
TUNNEL_TOKEN=paste-the-token-here
